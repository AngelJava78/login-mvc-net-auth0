@model IReadOnlyList<Auth0MvcDemo.DTOs.BookDto>
@{
    ViewData["Title"] = "Libros";
}

<div class="page-header">
    <div>
        <span class="eyebrow">API REST</span>
        <h2>Libros</h2>
        <p>Estos datos se obtienen desde la API configurada en <code>BooksApi:BaseUrl</code>.</p>
    </div>
    <a class="button" asp-action="Create">Nuevo libro</a>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <p>No hay libros registrados.</p>
    }
    else
    {
        <table>
            <thead>
            <tr>
                <th>Id</th>
                <th>Título</th>
                <th>Autor</th>
                <th>Año</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Id</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.PublicationYear</td>
                    <td class="table-actions">
                        <a asp-action="Edit" asp-route-id="@book.Id">Editar</a>
                        <a asp-action="Delete" asp-route-id="@book.Id">Eliminar</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
