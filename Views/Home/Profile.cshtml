@{
    ViewData["Title"] = "Mi identidad";
}
<section>
    <span class="eyebrow">[Authorize]</span>
    <h1>Identidad autenticada</h1>
    <p>Esta página solo puede abrirse si ASP.NET Core considera autenticado al usuario.</p>
    <div class="card">
        <h2>Claims disponibles</h2>
        <table>
            <thead><tr><th>Tipo</th><th>Valor</th></tr></thead>
            <tbody>
            @foreach (var claim in User.Claims)
            {
                <tr><td>@claim.Type</td><td>@claim.Value</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
