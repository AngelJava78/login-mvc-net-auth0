@model Auth0MvcDemo.DTOs.UserDto
@{
    ViewData["Title"] = "Eliminar usuario";
}

<div class="form-page">
    <span class="eyebrow">API REST</span>
    <h2>Eliminar usuario</h2>

    <div class="card form-card">
        <p>¿Deseas eliminar este usuario?</p>
        <dl>
            <dt>Nombre</dt>
            <dd>@Model.Name</dd>
            <dt>Email</dt>
            <dd>@Model.Email</dd>
            <dt>Auth0 ID</dt>
            <dd>@Model.Auth0UserId</dd>
            <dt>Activo</dt>
            <dd>@(Model.IsActive ? "Sí" : "No")</dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <div class="actions">
                <button class="button danger" type="submit">Eliminar</button>
                <a class="button secondary" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>
