@model Auth0MvcDemo.DTOs.UpdateUserDto
@{
    ViewData["Title"] = "Editar usuario";
}

<div class="form-page">
    <span class="eyebrow">API REST</span>
    <h2>Editar usuario</h2>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card form-card">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="validation"></span>

        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email" class="validation"></span>

        <label class="checkbox-row">
            <input asp-for="IsActive" />
            <span>Activo</span>
        </label>

        <div class="actions">
            <button class="button" type="submit">Guardar cambios</button>
            <a class="button secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
